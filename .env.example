HOST=127.0.0.1
PORT=3000

# 서울 열린데이터광장: 실시간 지하철 도착정보 인증키
SEOUL_SUBWAY_API_KEY=
# 공식 API 주소. 제공기관에서 HTTPS를 지원하면 HTTPS 주소로 변경하세요.
SEOUL_SUBWAY_BASE_URL=http://swopenapi.seoul.go.kr/api/subway/

# 공공데이터포털: 서울특별시 버스도착정보조회 서비스의 일반 인증키 (Decoding)
SEOUL_BUS_API_KEY=
SEOUL_BUS_BASE_URL=https://ws.bus.go.kr/api/rest/stationinfo/getStationByUid
